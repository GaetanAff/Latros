{
  "$defs": {
    "LicenseV2": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "implementation_rights_confirmed": {
          "title": "Implementation Rights Confirmed",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "redistribution": {
          "enum": [
            "allowed_with_attribution",
            "restricted",
            "prohibited",
            "unknown"
          ],
          "title": "Redistribution",
          "type": "string"
        },
        "restrictions": {
          "items": {
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "transformation_rights": {
          "anyOf": [
            {
              "enum": [
                "allowed",
                "restricted",
                "prohibited",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformation Rights"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "attribution",
        "redistribution",
        "implementation_rights_confirmed"
      ],
      "title": "LicenseV2",
      "type": "object"
    },
    "RegistryArtifactV2": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "enum": [
            "public_https",
            "manual_local"
          ],
          "title": "Access Mode",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "format": {
          "enum": [
            "rf2-concepts-tsv",
            "rf2-descriptions-tsv",
            "rf2-relationships-tsv",
            "curated-assertions-jsonl",
            "obographs-json",
            "html-capture",
            "curation-jsonl",
            "curation-package-json",
            "source-segments-json",
            "medlineplus-health-topics-xml",
            "medlineplus-health-topics-xml-zip",
            "mesh-descriptors-xml",
            "mesh-descriptors-xml-gzip",
            "mesh-qualifiers-xml",
            "mesh-supplemental-records-xml",
            "monarch-kg-tar-gzip",
            "monarch-kg-duckdb",
            "kgx-nodes-tsv-gzip",
            "kgx-edges-tsv-gzip",
            "jsonl-gzip",
            "rdf-ntriples-gzip",
            "orphadata-product4-xml"
          ],
          "title": "Format",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 35,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        },
        "product": {
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "product",
        "format",
        "source_url",
        "sha256",
        "access_mode"
      ],
      "title": "RegistryArtifactV2",
      "type": "object"
    },
    "RegistryDependencyV2": {
      "additionalProperties": false,
      "properties": {
        "dependency_type": {
          "enum": [
            "primary",
            "derived_from",
            "republication",
            "shared_upstream",
            "unknown"
          ],
          "title": "Dependency Type",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "upstream_reference": {
          "minLength": 1,
          "title": "Upstream Reference",
          "type": "string"
        }
      },
      "required": [
        "upstream_reference",
        "dependency_type",
        "evidence"
      ],
      "title": "RegistryDependencyV2",
      "type": "object"
    },
    "SnapshotScopeV2": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "exclusions": {
          "items": {
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "observation_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observation Types",
          "type": "array"
        },
        "population": {
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "relations": {
          "items": {
            "enum": [
              "has_symptom",
              "has_sign",
              "has_risk_factor",
              "has_lab_finding",
              "has_exam_finding",
              "has_imaging_finding",
              "typical_age",
              "typical_sex",
              "has_complication"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Relations",
          "type": "array"
        },
        "scope_id": {
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "scope_id",
        "domain",
        "population",
        "observation_types",
        "relations"
      ],
      "title": "SnapshotScopeV2",
      "type": "object"
    },
    "SourcePackageV2": {
      "additionalProperties": false,
      "properties": {
        "access_date": {
          "format": "date",
          "title": "Access Date",
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/RegistryArtifactV2"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "capture_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Identity"
        },
        "code_system": {
          "minLength": 1,
          "title": "Code System",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/RegistryDependencyV2"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "homepage": {
          "minLength": 1,
          "title": "Homepage",
          "type": "string"
        },
        "importer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Importer"
        },
        "license": {
          "$ref": "#/$defs/LicenseV2"
        },
        "producer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer"
        },
        "release": {
          "title": "Release",
          "type": "string"
        },
        "release_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Date"
        },
        "release_identity_method": {
          "default": "publisher_release",
          "enum": [
            "publisher_release",
            "dated_capture"
          ],
          "title": "Release Identity Method",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "roles",
        "code_system",
        "homepage",
        "release",
        "access_date",
        "license",
        "artifacts"
      ],
      "title": "SourcePackageV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canonical_schema_version": {
      "const": 2,
      "default": 2,
      "title": "Canonical Schema Version",
      "type": "integer"
    },
    "compatible_profiles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Compatible Profiles",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/SnapshotScopeV2"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourcePackageV2"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "scope",
    "compatible_profiles",
    "sources"
  ],
  "title": "RegistryV2",
  "type": "object"
}
